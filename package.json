{
  "name": "olemmy",
  "private": true,
  "description": "An old-school, information-dense web client for Lemmy. The site itself has no build step and no runtime dependencies; this file is for development tools only.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "serve": "node scripts/serve.mjs web 8000",
    "build": "./scripts/build.sh -c",
    "test": "node --test 'tests/unit/*.test.mjs'",
    "test:e2e": "playwright test",
    "test:e2e:dist": "./scripts/build.sh -c -q && OLEMMY_E2E_ROOT=dist/web playwright test",
    "compat": "node scripts/compat.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
